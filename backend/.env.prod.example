# Production environment — copy to .env.prod and fill in secrets
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database (matches docker-compose.prod.yml service name)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=noted_prod
DB_USER=noteduser
DB_PASSWORD=CHANGE_ME

# Authentication — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# File uploads
MAX_FILE_SIZE=26214400
UPLOAD_DIR=/app/uploads

# Backups (read by GET /api/v1/system/stats — should be a mounted volume in prod)
BACKUP_DIR=/app/backups

# Logging
LOG_LEVEL=info
LOG_DIR=/app/logs

# CORS
CORS_ORIGIN=https://noted.example.com

# Rate Limiting

# LLM Gateway (Phase 7 OCR, Phase 8 intelligence)
LLM_GATEWAY_URL=http://localhost:8080
LLM_ENABLED=true
LLM_OCR_TIMEOUT_MS=120000
LLM_TRANSLATE_TIMEOUT_MS=150000
LLM_TRANSLATE_MAX_CHARS=8000
# ocr-llm client identity. The gateway runs CLIENT_AUTH_MODE=enforce, so without
# this key every gateway call returns 401. Issued out of band by the gateway
# operator; the client id is hardcoded to "noted". Verify a deploy against
# /clients (401 unauthenticated, and the body reports this client's own
# key_configured / rejected counts) — /health answers 200 with no headers at
# all, so it cannot tell a configured deploy from an unconfigured one.
OCR_LLM_CLIENT_KEY=CHANGE_ME

# AI provider keys (CR038) — master key that encrypts stored provider API keys.
# Required only once you configure a non-gateway provider (Claude/OpenAI/local).
# Generate with: openssl rand -hex 32  (leave blank if you only use the gateway)
AI_KEYS_ENC_KEY=
# Set to true only to point a "Local / OpenAI-compatible" provider at a private,
# loopback or Tailscale host (e.g. an Ollama box). The built-in gateway does not need it.
AI_PROVIDER_ALLOW_PRIVATE=false

# AI Assist (text generation)
LLM_GENERATION_MODEL=
LLM_CONTEXT_WINDOW=32000
LLM_GENERATE_TIMEOUT_MS=180000
# Route AI Assist quick / deep modes through ocr-llm /task with the
# registered noted_ai_assist_quick / noted_ai_assist_deep fallback chains.
# Set false to bridge via /llm/generate using LLM_QUICK_MODEL / LLM_DEEP_MODEL.
LLM_TASK_ENABLED=true
# Bridging defaults used when LLM_TASK_ENABLED=false:
# LLM_QUICK_MODEL=phi4:14b
# LLM_DEEP_MODEL=qwen3.6:35b-a3b-q4_K_M
# LLM_GENERATE_DEEP_TIMEOUT_MS=600000

# Google Drive Integration
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://noted.example.com/api/v1/integrations/google-drive/callback
