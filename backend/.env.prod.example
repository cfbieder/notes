# Production environment — copy to .env.prod and fill in secrets
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database (matches docker-compose.prod.yml service name)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=noted_prod
DB_USER=noteduser
DB_PASSWORD=CHANGE_ME

# Authentication — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# File uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads

# Logging
LOG_LEVEL=info
LOG_DIR=/app/logs

# CORS
CORS_ORIGIN=https://noted.tail413695.ts.net

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Google Drive Integration
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://noted.tail413695.ts.net/api/v1/integrations/google-drive/callback
