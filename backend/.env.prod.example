# Production environment — copy to .env.prod and fill in secrets
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# Database (matches docker-compose.prod.yml service name)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=noted_prod
DB_USER=noteduser
DB_PASSWORD=CHANGE_ME

# Authentication — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# File uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=/app/uploads

# Backups (read by GET /api/v1/system/stats — should be a mounted volume in prod)
BACKUP_DIR=/app/backups

# Logging
LOG_LEVEL=info
LOG_DIR=/app/logs

# CORS
CORS_ORIGIN=https://noted.tail413695.ts.net

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# LLM Gateway (Phase 7 OCR, Phase 8 intelligence)
LLM_GATEWAY_URL=http://100.66.213.40:8080
LLM_ENABLED=true
LLM_OCR_TIMEOUT_MS=120000
LLM_TRANSLATE_TIMEOUT_MS=150000
LLM_TRANSLATE_MAX_CHARS=8000

# AI Assist (text generation)
LLM_GENERATION_MODEL=
LLM_CONTEXT_WINDOW=32000
LLM_GENERATE_TIMEOUT_MS=180000

# Google Drive Integration
GOOGLE_CLIENT_ID=CHANGE_ME
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_REDIRECT_URI=https://noted.tail413695.ts.net/api/v1/integrations/google-drive/callback
