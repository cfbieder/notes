# Server
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=noted_dev
DB_USER=noteduser
DB_PASSWORD=noted_dev_password

# Authentication
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# File uploads
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# LLM Gateway (Phase 7 OCR, Phase 8 intelligence)
LLM_GATEWAY_URL=http://localhost:8080
LLM_ENABLED=true
LLM_OCR_TIMEOUT_MS=120000
LLM_TRANSLATE_TIMEOUT_MS=150000
LLM_TRANSLATE_MAX_CHARS=8000

# AI provider keys (CR038) — master key that encrypts stored provider API keys.
# Required only once you configure a non-gateway provider (Claude/OpenAI/local).
# Generate with: openssl rand -hex 32
AI_KEYS_ENC_KEY=

# AI Assist (text generation)
LLM_GENERATION_MODEL=
LLM_CONTEXT_WINDOW=32000
LLM_GENERATE_TIMEOUT_MS=180000
