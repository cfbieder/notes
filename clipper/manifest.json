{
  "manifest_version": 3,
  "name": "Noted Web Clipper (dev)",
  "version": "0.3.0",
  "description": "Clip pages, selections, and screenshots into your Noted instance.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "http://localhost:3001/*",
    "http://100.119.240.123:3001/*",
    "https://noted.tail413695.ts.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clip to Noted"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
